	partition Date = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        MIN(Orders[order_purchase_date]),
				        MAX(Orders[order_purchase_date])
				    ),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "Year Month", FORMAT([Date], "YYYY-MM"),
				    "Year Month Sort", YEAR([Date]) * 100 + MONTH([Date])
				)

	annotation PBI_Id = 2bdfc17053da424880483f3bd16d398d

