# Copy this file to .env and replace the example values.
# Never commit the populated .env file.

OLIST_SQL_SERVER=localhost,1433
OLIST_SQL_DATABASE=OlistAnalytics
OLIST_SQL_USERNAME=sa
OLIST_SQL_PASSWORD=replace_with_your_local_password
OLIST_SQL_DRIVER=ODBC Driver 18 for SQL Server
OLIST_SQL_ENCRYPT=yes
OLIST_SQL_TRUST_SERVER_CERTIFICATE=yes
